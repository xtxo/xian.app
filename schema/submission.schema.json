{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xtxo/xian.app/blob/main/schema/submission.schema.json",
  "title": "XIAN.APP Product Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "tagline",
    "description",
    "website_url",
    "open_source_url",
    "creator",
    "categories",
    "images",
    "submitted_via"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4000
    },
    "website_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "open_source_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover", "screenshots"],
      "properties": {
        "cover": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "screenshots": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "submitted_via": {
      "const": "github"
    }
  }
}
